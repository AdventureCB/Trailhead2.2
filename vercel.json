{
  "buildCommand": null,
  "outputDirectory": "deploy-v2.2",
  "framework": null,
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap.xml" },
    { "source": "/r/:code", "destination": "/api/r?code=:code" },
    { "source": "/trips/:slug", "destination": "/api/preview?type=trip&id=:slug" },
    { "source": "/plans/:slug", "destination": "/api/preview?type=plan&id=:slug" },
    { "source": "/drops/:slug", "destination": "/api/preview?type=gear-drop&id=:slug" },
    { "source": "/spots/:id", "destination": "/api/preview?type=spot&id=:id" },
    { "source": "/builds/:id", "destination": "/api/preview?type=build&id=:id" },
    { "source": "/bounties/:id", "destination": "/api/preview?type=bounty&id=:id" },
    { "source": "/post/:id", "destination": "/api/preview?type=post&id=:id" },
    { "source": "/forum/:sub/:slug", "destination": "/api/preview?type=forum-thread&sub=:sub&slug=:slug" },
    { "source": "/forum/:sub", "destination": "/api/preview?type=forum-sub&sub=:sub" },
    { "source": "/users/:handle", "destination": "/api/preview?type=user&handle=:handle" },
    { "source": "/hq", "destination": "/api/preview?type=hq" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/preview.js": {
      "includeFiles": "deploy-v2.2/index.html"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/trailhead-bundle.:hash.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
