<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- OAuth / email-confirmation / password-reset callback (custom
                 scheme). Supabase redirects to
                 com.lonepeakoverland.trailhub://login-callback#access_token=…;
                 Capacitor's App plugin surfaces it as appUrlOpen → native-bridge
                 dispatches trailhead:oauth. Same scheme the iOS app uses. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.lonepeakoverland.trailhub" android:host="login-callback" />
            </intent-filter>

            <!-- Android App Links: https://trailhead.lonepeakoverland.com/… opens
                 in the app once /.well-known/assetlinks.json carries the Play
                 App Signing SHA-256 (added after the first upload). Until it
                 verifies, links keep opening in the browser — harmless. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="trailhead.lonepeakoverland.com" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Maps / route recording / recovery alerts (WebView geolocation prompts
         through the OS; the app explains why in its own sheet first). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Photo capture from <input type="file" capture> in the WebView. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Android 13+ runtime permission for OneSignal push. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Gear-drop waypoint haptics. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Hardware features are optional so tablets / devices without them can install. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
</manifest>
